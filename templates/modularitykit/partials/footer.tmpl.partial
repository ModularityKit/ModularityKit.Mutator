<footer class="site-footer">
  <div class="grad-bottom"></div>
  <div class="footer">
    <div class="container site-footer__inner">
      <span class="site-footer__brand">ModularityKit.Mutator</span>
      <span class="site-footer__text">Generated from XML docs and published from main.</span>
      <span class="pull-right">
        <a href="#top">{{__global.backToTop}}</a>
      </span>
    </div>
  </div>
</footer>
<script>
  (function () {
    var nav = document.querySelector('.site-nav');
    if (!nav) {
      return;
    }

    var path = window.location.pathname.replace(/\/+$/, '') || '/';
    var items = Array.prototype.slice.call(nav.querySelectorAll('a'));
    var match = null;

    function isPrefix(prefix) {
      return path === prefix || path.indexOf(prefix + '/') === 0;
    }

    if (path === '/' || /\/index\.html?$/.test(path) || isPrefix('/Docs/Home')) {
      match = 'index.html';
    } else if (isPrefix('/src/Redis')) {
      match = 'src/Redis/README.html';
    } else if (isPrefix('/src/Governance')) {
      match = 'src/Governance/README.html';
    } else if (isPrefix('/Docs/API')) {
      match = 'Docs/API/Reference.html';
    } else if (isPrefix('/Docs')) {
      match = 'index.html';
    } else if (isPrefix('/src')) {
      match = 'src/README.html';
    }

    items.forEach(function (link) {
      var item = link.closest('li');
      if (!item) {
        return;
      }

      var href = link.getAttribute('href') || '';
      var active = false;

      if (match === 'index.html') {
        active = href.indexOf('index.html') !== -1;
      } else if (match) {
        active = href.indexOf(match) !== -1;
      }

      if (active) {
        item.classList.add('active');
        link.setAttribute('aria-current', 'page');
      }
    });
  })();
</script>
